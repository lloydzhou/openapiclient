{
  "openapi": "3.0.0",
  "info": {"title": "Petstore", "version": "1.0.0", "description": "test fixture"},
  "servers": [{"url": "http://api.example.com/v1"}],
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "summary": "List pets",
        "parameters": [
          {"name": "limit", "in": "query", "schema": {"type": "integer"}, "description": "page size"},
          {"name": "status", "in": "query", "schema": {"type": "string", "enum": ["available", "sold"]}},
          {"name": "tags", "in": "query", "schema": {"type": "array", "items": {"type": "string"}}}
        ],
        "responses": {"200": {"description": "ok"}}
      },
      "post": {
        "operationId": "createPet",
        "summary": "Create a pet",
        "requestBody": {"content": {"application/json": {"schema": {"type": "object"}}}},
        "responses": {"201": {"description": "created"}}
      }
    },
    "/pets/{petId}": {
      "parameters": [
        {"$ref": "#/components/parameters/PetId"}
      ],
      "get": {
        "operationId": "getPet",
        "summary": "Get one pet",
        "responses": {"200": {"description": "ok"}}
      },
      "delete": {
        "summary": "delete without operationId",
        "responses": {"204": {"description": "deleted"}}
      }
    }
  },
  "components": {
    "parameters": {
      "PetId": {"name": "petId", "in": "path", "required": true, "schema": {"type": "integer"}, "description": "the pet id"}
    }
  }
}
